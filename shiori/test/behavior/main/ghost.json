{
  "format": "nashi/1",
  "_comment": [
    "栞のふるまい（どのブロックを選ぶか・しぼり込み・くりかえしの間引き・通信）を",
    "確かめるためのゴーストです。behavior.js が期待する応答を持っているので、",
    "ここを直したら behavior.js の期待値も直してください。",
    "どれを選ぶかが1つに決まるように、同じイベントに複数置くときは条件で分けています。"
  ],
  "meta": { "name": "ふるまいテスト", "sakuraName": "さくら", "keroName": "うにゅう" },
  "settings": { "randomTalkEnabled": false },
  "variables": [{ "name": "かず", "value": 0 }, { "name": "こたえ", "value": "" }],
  "scripts": [
    {
      "id": "b_boot", "kind": "event", "event": "OnBoot",
      "blocks": [{ "type": "say", "who": 0, "text": "おきた", "nl": 0 }]
    },
    {
      "id": "b_close", "kind": "event", "event": "OnClose",
      "_": "\\- を書いていないので、栞が足すはず",
      "blocks": [{ "type": "say", "who": 0, "text": "ばいばい", "nl": 0 }]
    },

    {
      "id": "b_nade_any", "kind": "event", "event": "OnNadeNade",
      "_": "条件なし。あたま用があるときは、そちらに負けるはず",
      "blocks": [{ "type": "say", "who": 0, "text": "どこか", "nl": 0 }]
    },
    {
      "id": "b_nade_head", "kind": "event", "event": "OnNadeNade",
      "filter": { "area": "Head" },
      "blocks": [{ "type": "say", "who": 0, "text": "あたま", "nl": 0 }]
    },

    {
      "id": "b_comm_any", "kind": "event", "event": "OnCommunicate",
      "_": "条件なし",
      "blocks": [{ "type": "say", "who": 0, "text": "だれか", "nl": 0 }]
    },
    {
      "id": "b_comm_word", "kind": "event", "event": "OnCommunicate",
      "filter": { "contains": "こんにちは" },
      "_": "言葉つき。条件なしより優先されるはず",
      "blocks": [{ "type": "say", "who": 0, "text": "あいさつ", "nl": 0 }]
    },
    {
      "id": "b_comm_from", "kind": "event", "event": "OnCommunicate",
      "filter": { "from": "みかん", "contains": "ねえ" },
      "_": "相手＋言葉。いちばん細かいので、これが最優先",
      "blocks": [
        { "type": "communicate", "who": 0, "to": { "type": "sys", "key": "commfrom" },
          "text": "みかんだ" }
      ]
    },

    {
      "id": "b_every", "kind": "event", "event": "OnSecondChange", "everySec": 3,
      "_": "3 秒ごと。毎秒たたいても 3 回に 1 回しか動かないはず",
      "blocks": [
        { "type": "change", "name": "かず", "value": 1 },
        { "type": "say", "who": 0, "text": { "type": "var", "name": "かず" }, "nl": 0 }
      ]
    },

    {
      "id": "b_empty_out", "kind": "event", "event": "OnEmptyOut",
      "_": "何も出力しない。204 が返るはず",
      "blocks": [{ "type": "set", "name": "かず", "value": { "type": "var", "name": "かず" } }]
    },

    {
      "id": "b_saori_real", "kind": "event", "event": "OnSaoriReal",
      "_": "本物の SAORI（テスト用のおそいもの）を、答えを待たずによぶ",
      "blocks": [
        { "type": "saori_call", "file": "slow_saori.dll", "a": "200", "b": "ぬるい",
          "into": "こたえ" }
      ]
    },
    {
      "id": "b_saori_slow", "kind": "event", "event": "OnSaoriVerySlow",
      "_": "栞が待つ時間（5 秒）より長くかかる呼び出し。終了と重なる場面を作る",
      "blocks": [
        { "type": "saori_call", "file": "slow_saori.dll", "a": "6500", "b": "おそい",
          "into": "こたえ" }
      ]
    },
    {
      "id": "b_saori_sync", "kind": "event", "event": "OnSaoriSync",
      "_": "答えを待つほうの呼び出し（ふつうの使いかた）",
      "blocks": [
        { "type": "say", "who": 0, "nl": 0,
          "text": { "type": "saori", "file": "slow_saori.dll", "a": "50", "b": "すぐ",
                    "value": -1 } }
      ]
    },
    {
      "id": "b_saori_call", "kind": "event", "event": "OnSaoriTest",
      "_": "答えを待たずに SAORI をよぶ。本物の DLL は無いので、答えは空で届くはず",
      "blocks": [
        { "type": "saori_call", "file": "nai.dll", "a": "ひとつめ", "into": "こたえ" }
      ]
    },
    {
      "id": "b_saori_done", "kind": "event", "event": "OnSaoriDone",
      "_": "答えが届いたら、つぎの「ずっとくりかえす」で呼ばれるはず",
      "blocks": [
        { "type": "say", "who": 0, "nl": 0,
          "text": { "type": "join", "a": "とどいた:", "b": { "type": "ref", "index": 0 } } }
      ]
    },

    {
      "id": "b_group", "kind": "event", "event": "OnGroupTest",
      "_": "まとまりからよぶ。中身が 1 つなら、それが出るはず",
      "blocks": [{ "type": "call_group", "group": "よる" }]
    },
    {
      "id": "t_yoru", "kind": "talk", "name": "よるのトーク", "weight": 1, "group": "よる",
      "blocks": [{ "type": "say", "who": 0, "text": "おやすみ", "nl": 0 }]
    },
    {
      "id": "t_nogroup", "kind": "talk", "name": "まとまり無し", "weight": 1,
      "blocks": [{ "type": "say", "who": 0, "text": "でない", "nl": 0 }]
    },

    {
      "id": "b_ask", "kind": "event", "event": "OnAskTest",
      "_": "たずねる。答えは OnUserInput で返ってきて、栞が変数に入れるはず",
      "blocks": [{ "type": "ask", "into": "こたえ", "initial": "" }]
    },
    {
      "id": "b_show", "kind": "event", "event": "OnShowAnswer",
      "blocks": [{ "type": "say", "who": 0, "nl": 0, "text": { "type": "var", "name": "こたえ" } }]
    },

    {
      "id": "b_later", "kind": "event", "event": "OnLaterTest",
      "_": "5 秒後によぶ。予約するだけなので、ここでは何も出ないはず",
      "blocks": [{ "type": "later", "sec": 5, "name": "あとで" }]
    },
    {
      "id": "f_later", "kind": "function", "name": "あとで",
      "blocks": [{ "type": "say", "who": 0, "text": "おまたせ", "nl": 0 }]
    },

    {
      "id": "b_choice", "kind": "event", "event": "OnChoiceTest",
      "blocks": [{ "type": "choice", "label": "はい", "target": "こたえ" }]
    },
    {
      "id": "f_answer", "kind": "function", "name": "こたえ",
      "blocks": [{ "type": "say", "who": 0, "text": "えらばれた", "nl": 0 }]
    }
  ]
}
