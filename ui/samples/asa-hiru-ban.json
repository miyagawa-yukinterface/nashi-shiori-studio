{
  "format": "nashi/1",
  "meta": {
    "name": "時間で変わるゴースト",
    "sakuraName": "なしこ",
    "keroName": "つぶ",
    "version": "1.0.0",
    "description": "「いまごろ」で、朝・昼・夕方・夜のトークを出し分けます。"
  },
  "settings": { "randomTalkEnabled": true, "randomTalkInterval": 90 },
  "variables": [],
  "scripts": [
    {
      "id": "t_boot", "kind": "event", "event": "OnBoot", "x": 60, "y": 40,
      "blocks": [
        { "type": "say", "who": 0, "nl": 1,
          "text": { "type": "join",
                    "a": { "type": "sys", "key": "daypart" }, "b": "だね。" } },
        { "type": "call_group", "group": "じかん" }
      ]
    },
    {
      "id": "t_pick", "kind": "event", "event": "OnMouseDoubleClick", "x": 60, "y": 260,
      "_": "ダブルクリックでも、いまの時間に合うトークを出す",
      "blocks": [{ "type": "call_group", "group": "じかん" }]
    },
    {
      "id": "t_asa", "kind": "talk", "name": "朝のトーク", "weight": 1, "group": "じかん",
      "x": 520, "y": 40,
      "blocks": [
        { "type": "if",
          "cond": { "type": "compare", "op": "=",
                    "a": { "type": "sys", "key": "daypart" }, "b": "朝" },
          "then": [
            { "type": "surface", "who": 0, "id": 1 },
            { "type": "say", "who": 0, "text": "おはよう。今日もがんばろうね。", "nl": 1 }
          ] }
      ]
    },
    {
      "id": "t_hiru", "kind": "talk", "name": "昼のトーク", "weight": 1, "group": "じかん",
      "x": 520, "y": 280,
      "blocks": [
        { "type": "if",
          "cond": { "type": "compare", "op": "=",
                    "a": { "type": "sys", "key": "daypart" }, "b": "昼" },
          "then": [
            { "type": "say", "who": 0, "text": "おひるごはん、食べた？", "nl": 1 }
          ] }
      ]
    },
    {
      "id": "t_yuu", "kind": "talk", "name": "夕方のトーク", "weight": 1, "group": "じかん",
      "x": 520, "y": 500,
      "blocks": [
        { "type": "if",
          "cond": { "type": "compare", "op": "=",
                    "a": { "type": "sys", "key": "daypart" }, "b": "夕方" },
          "then": [
            { "type": "say", "who": 0, "text": "そろそろ 夕ごはんの時間かな。", "nl": 1 }
          ] }
      ]
    },
    {
      "id": "t_yoru", "kind": "talk", "name": "夜のトーク", "weight": 1, "group": "じかん",
      "x": 520, "y": 720,
      "blocks": [
        { "type": "if",
          "cond": { "type": "compare", "op": "=",
                    "a": { "type": "sys", "key": "daypart" }, "b": "夜" },
          "then": [
            { "type": "surface", "who": 0, "id": 2 },
            { "type": "say", "who": 0, "text": "もう夜だね。夜ふかしはほどほどに。", "nl": 1 }
          ] }
      ]
    },
    {
      "id": "t_kisetsu", "kind": "talk", "name": "季節の話", "weight": 1, "x": 60, "y": 420,
      "blocks": [
        { "type": "say", "who": 0, "nl": 1,
          "text": { "type": "join",
                    "a": { "type": "sys", "key": "season" }, "b": "は すきだなあ。" } }
      ]
    }
  ]
}
