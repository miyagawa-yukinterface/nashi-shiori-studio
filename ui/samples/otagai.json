{
  "format": "nashi/1",
  "meta": {
    "name": "話しかけるゴースト",
    "sakuraName": "なしこ",
    "keroName": "つぶ",
    "version": "1.0.0",
    "description": "ほかのゴーストに話しかけ、話しかけられたら返します。"
  },
  "settings": {
    "randomTalkEnabled": true,
    "randomTalkInterval": 180
  },
  "variables": [],
  "scripts": [
    {
      "id": "o_hello",
      "kind": "event",
      "event": "OnCommunicate",
      "from": "",
      "contains": "こんにちは",
      "x": 60,
      "y": 40,
      "_": "「こんにちは」と言われたときだけ。条件つきのほうが先に選ばれます",
      "blocks": [
        {
          "type": "surface",
          "who": 0,
          "id": 1
        },
        {
          "type": "communicate",
          "who": 0,
          "to": {
            "type": "sys",
            "key": "commfrom"
          },
          "text": "こんにちは。"
        }
      ]
    },
    {
      "id": "o_any",
      "kind": "event",
      "event": "OnCommunicate",
      "x": 60,
      "y": 300,
      "_": "条件なし。上のどれにも当てはまらないときに使われます",
      "blocks": [
        {
          "type": "say",
          "who": 0,
          "nl": 1,
          "text": {
            "type": "join",
            "a": {
              "type": "sys",
              "key": "commfrom"
            },
            "b": " に話しかけられた。"
          }
        },
        {
          "type": "communicate",
          "who": 0,
          "to": {
            "type": "sys",
            "key": "commfrom"
          },
          "text": "そうなんだ。"
        }
      ]
    },
    {
      "id": "o_start",
      "kind": "event",
      "event": "OnMouseDoubleClick",
      "x": 560,
      "y": 40,
      "_": "こちらから話しかける。相手の名前は、その子の本体（\\0）の名前です",
      "blocks": [
        {
          "type": "say",
          "who": 0,
          "text": "だれかに話しかけてみよう。",
          "nl": 1
        },
        {
          "type": "communicate",
          "who": 0,
          "to": "さくら",
          "text": "こんにちは。"
        }
      ]
    },
    {
      "id": "o_changed",
      "kind": "event",
      "event": "OnGhostChanged",
      "x": 560,
      "y": 300,
      "blocks": [
        {
          "type": "say",
          "who": 0,
          "nl": 1,
          "text": {
            "type": "join",
            "a": {
              "type": "ref",
              "index": 0
            },
            "b": " からきたよ。"
          }
        }
      ]
    },
    {
      "id": "o_talk",
      "kind": "talk",
      "name": "ひとりごと",
      "weight": 1,
      "x": 560,
      "y": 560,
      "blocks": [
        {
          "type": "say",
          "who": 0,
          "text": "だれか あそびに来ないかなあ。",
          "nl": 1
        }
      ]
    }
  ]
}
