{
  "format": "nashi/1",
  "meta": {
    "name": "あいさつゴースト",
    "sakuraName": "なしこ",
    "keroName": "つぶ",
    "version": "1.0.0",
    "description": "起動・終了・ダブルクリックだけの、いちばん小さいゴーストです。"
  },
  "settings": { "randomTalkEnabled": true, "randomTalkInterval": 180 },
  "variables": [],
  "scripts": [
    {
      "id": "a_first", "kind": "event", "event": "OnFirstBoot", "x": 60, "y": 40,
      "blocks": [
        { "type": "surface", "who": 0, "id": 1 },
        { "type": "say", "who": 0, "text": "はじめまして。なしこです。", "nl": 1 },
        { "type": "say", "who": 0, "text": "よろしくね。", "nl": 1 }
      ]
    },
    {
      "id": "a_boot", "kind": "event", "event": "OnBoot", "x": 60, "y": 240,
      "blocks": [
        { "type": "surface", "who": 0, "id": 1 },
        { "type": "say", "who": 0, "text": "おかえりなさい。", "nl": 1 }
      ]
    },
    {
      "id": "a_close", "kind": "event", "event": "OnClose", "x": 60, "y": 420,
      "blocks": [
        { "type": "say", "who": 0, "text": "またね。", "nl": 1 }
      ]
    },
    {
      "id": "a_click", "kind": "event", "event": "OnMouseDoubleClick", "x": 480, "y": 40,
      "blocks": [
        { "type": "random_one", "branches": [
          [{ "type": "say", "who": 0, "text": "なあに？", "nl": 1 }],
          [{ "type": "say", "who": 0, "text": "呼んだ？", "nl": 1 }],
          [{ "type": "say", "who": 0, "text": "どうしたの？", "nl": 1 }]
        ] }
      ]
    },
    {
      "id": "a_talk1", "kind": "talk", "name": "そらの話", "weight": 1, "x": 480, "y": 300,
      "blocks": [
        { "type": "say", "who": 0, "text": "そとは いい天気かなあ。", "nl": 1 }
      ]
    },
    {
      "id": "a_talk2", "kind": "talk", "name": "おちゃの話", "weight": 1, "x": 480, "y": 440,
      "blocks": [
        { "type": "say", "who": 0, "text": "おちゃでも いれようか。", "nl": 1 }
      ]
    }
  ]
}
