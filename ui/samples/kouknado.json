{
  "format": "nashi/1",
  "meta": {
    "name": "好感度ゴースト",
    "sakuraName": "なしこ",
    "keroName": "つぶ",
    "version": "1.0.0",
    "description": "なでられると好感度が上がって、しゃべる内容が変わります。"
  },
  "settings": { "randomTalkEnabled": true, "randomTalkInterval": 120 },
  "variables": [{ "name": "好感度", "value": 0 }],
  "scripts": [
    {
      "id": "k_boot", "kind": "event", "event": "OnBoot", "x": 60, "y": 40,
      "blocks": [
        { "type": "if_else",
          "cond": { "type": "compare", "op": ">",
                    "a": { "type": "var", "name": "好感度" }, "b": 5 },
          "then": [
            { "type": "surface", "who": 0, "id": 1 },
            { "type": "say", "who": 0, "text": "会いたかったよ。", "nl": 1 }
          ],
          "else": [
            { "type": "say", "who": 0, "text": "こんにちは。", "nl": 1 }
          ] }
      ]
    },
    {
      "id": "k_nade", "kind": "event", "event": "OnNadeNade", "area": "Head", "who": 0,
      "x": 60, "y": 300,
      "blocks": [
        { "type": "change", "name": "好感度", "value": 1 },
        { "type": "surface", "who": 0, "id": 1 },
        { "type": "if_else",
          "cond": { "type": "compare", "op": ">",
                    "a": { "type": "var", "name": "好感度" }, "b": 10 },
          "then": [
            { "type": "say", "who": 0, "text": "えへへ、うれしい。", "nl": 1 }
          ],
          "else": [
            { "type": "say", "who": 0, "text": "くすぐったいよ。", "nl": 1 }
          ] }
      ]
    },
    {
      "id": "k_bust", "kind": "event", "event": "OnNadeNade", "area": "Bust", "who": 0,
      "x": 60, "y": 620,
      "blocks": [
        { "type": "change", "name": "好感度", "value": -1 },
        { "type": "surface", "who": 0, "id": 2 },
        { "type": "say", "who": 0, "text": "……そこは だめ。", "nl": 1 }
      ]
    },
    {
      "id": "k_talk", "kind": "talk", "name": "いまの気もち", "weight": 2, "x": 560, "y": 40,
      "blocks": [
        { "type": "if_else",
          "cond": { "type": "compare", "op": ">",
                    "a": { "type": "var", "name": "好感度" }, "b": 8 },
          "then": [
            { "type": "say", "who": 0, "text": "きょうは たのしいね。", "nl": 1 }
          ],
          "else": [
            { "type": "say", "who": 0, "text": "ひまだなあ。", "nl": 1 }
          ] }
      ]
    },
    {
      "id": "k_show", "kind": "talk", "name": "好感度をいう", "weight": 1, "x": 560, "y": 320,
      "blocks": [
        { "type": "say", "who": 0, "nl": 1,
          "text": { "type": "join", "a": "いまの好感度は ",
                    "b": { "type": "join",
                           "a": { "type": "var", "name": "好感度" }, "b": " だよ。" } } }
      ]
    }
  ]
}
